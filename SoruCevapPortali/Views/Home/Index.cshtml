@model IEnumerable<SoruCevapPortali.Models.Question>

@{
    ViewData["Title"] = "Ana Sayfa - Son Sorular";
}

<div class="text-center">
    <h1 class="display-4">Soru Cevap Portalı</h1>
    <p>Aklınızdaki soruları sorun, bilgilerinizi paylaşın.</p>
</div>

<hr />

<div class="row">
    <div class="col-md-12">
        <h2>Son Sorular</h2>

        @if (Model != null && Model.Any())
        {
            // DÜZELTME: Değişken adını 'question' yaptık
            foreach (var question in Model)
            {
                <div class="card mb-3">
                    <div class="card-body">
                        <h5 class="card-title">@question.title</h5>

                        <p class="card-text">@question.contents</p>
                    </div>
                    <div class="card-footer text-muted">
                        <span class="badge badge-info" style="font-size: 0.9rem;">@question.Category?.Name</span> ·

                        <strong>@question.Answers.Count()</strong> cevap ·

                        @question.User?.User_name tarafından

                        @question.creation_date.ToShortDateString() tarihinde soruldu.
                        @question.creation_date.ToShortDateString() tarihinde soruldu.

                        <button class="btn btn-sm btn-outline-danger float-right report-btn"
                                data-type="question"
                                data-id="@question.Id">
                            🚩 Şikayet Et
                        </button>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="alert alert-info" role="alert">
                Henüz gösterilecek onaylanmış bir soru bulunmamaktadır.
            </div>
        }
    </div>
</div>

<div class="modal fade" id="reportModal" tabindex="-1" role="dialog" aria-labelledby="reportModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="reportModalLabel">İçeriği Şikayet Et</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Kapat">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <form id="reportForm">
                    <input type="hidden" id="reportQuestionId" name="questionId" />
                    <input type="hidden" id="reportAnswerId" name="answerId" />

                    <div class="form-group">
                        <label for="reportReason">Şikayet Sebebi:</label>
                        <textarea class="form-control" id="reportReason" name="reason" rows="3" placeholder="Lütfen sebebi belirtin..." required></textarea>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">İptal</button>
                <button type="button" class="btn btn-danger" id="submitReport">Gönder</button>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script>
        $(document).ready(function () {
            // "Şikayet Et" butonuna basılınca
            $('.report-btn').click(function () {
                var type = $(this).data('type'); // "question" mı "answer" mı?
                var id = $(this).data('id');     // ID kaç?

                // Önceki verileri temizle
                $('#reportQuestionId').val('');
                $('#reportAnswerId').val('');
                $('#reportReason').val('');

                // ID'yi doğru kutucuğa koy
                if (type === 'question') {
                    $('#reportQuestionId').val(id);
                } else {
                    $('#reportAnswerId').val(id);
                }

                // Modalı aç
                $('#reportModal').modal('show');
            });

            // Modaldaki "Gönder" butonuna basılınca
            $('#submitReport').click(function () {
                var reason = $('#reportReason').val();
                if (!reason) {
                    alert("Lütfen bir sebep yazın.");
                    return;
                }

                var formData = {
                    questionId: $('#reportQuestionId').val(),
                    answerId: $('#reportAnswerId').val(),
                    reason: reason
                };

                $.ajax({
                    url: '/Report/Create',
                    type: 'POST',
                    data: formData,
                    headers: {
                        // AntiForgeryToken'ı sayfanın herhangi bir yerinden bulup alıyoruz
                        "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
                    },
                    success: function (response) {
                        $('#reportModal').modal('hide'); // Modalı kapat
                        if (response.success) {
                            alert(response.message);
                        } else {
                            alert("Hata: " + response.message);
                        }
                    },
                    error: function () {
                        alert("Sunucuyla iletişim kurulamadı.");
                    }
                });
            });
        });
    </script>
}