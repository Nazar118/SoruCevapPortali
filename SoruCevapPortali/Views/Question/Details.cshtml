@model SoruCevapPortali.Models.Question

@{
    ViewData["Title"] = Model.title;
}

<div class="container mt-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Ana Sayfa</a></li>
            <li class="breadcrumb-item active" aria-current="page">Soru Detayı</li>
        </ol>
    </nav>

    <div class="card mb-4 border-left-primary shadow">
        <div class="card-header bg-white d-flex justify-content-between align-items-center">
            <h2 class="h4 m-0 text-primary">@Model.title</h2>
            <span class="badge badge-info">@Model.Category?.Name</span>
        </div>
        <div class="card-body">
            <p class="lead" style="font-size: 1.1rem;">@Model.contents</p>
        </div>
        <div class="card-footer bg-light text-muted d-flex justify-content-between">
            <small>
                <i class="fas fa-user"></i> @(Model.User?.User_name ?? "Anonim") tarafından
                @Model.creation_date.ToShortDateString() tarihinde soruldu.
            </small>
            <button class="btn btn-sm btn-outline-danger report-btn" data-type="question" data-id="@Model.Id">
                <i class="fas fa-flag"></i> Şikayet
            </button>
        </div>
    </div>

    <h4 class="mb-3"><i class="fas fa-comments"></i> Cevaplar (@(Model.Answers?.Count() ?? 0))</h4>

    @if (Model.Answers != null && Model.Answers.Any())
    {
        foreach (var answer in Model.Answers)
        {
            <div class="card mb-3 @(answer.IsBestAnswer ? "border-success" : "")">
                <div class="card-body">
                    @if (answer.IsBestAnswer)
                    {
                        <div class="mb-2"><span class="badge badge-success"><i class="fas fa-check"></i> En İyi Cevap</span></div>
                    }
                    <p class="card-text">@answer.contents</p>
                </div>
                <div class="card-footer bg-white d-flex justify-content-between align-items-center">
                    <small class="text-muted">
                        <i class="fas fa-user"></i> @(answer.User?.User_name ?? "Anonim") - @answer.creation_date.ToShortDateString()
                    </small>
                    <button class="btn btn-sm btn-outline-danger report-btn" data-type="answer" data-id="@answer.Id">
                        <i class="fas fa-flag"></i>
                    </button>
                </div>
            </div>
        }
    }
    else
    {
        <div class="alert alert-light border text-center p-4">
            Henüz cevap verilmemiş. İlk cevabı sen yaz!
        </div>
    }

    <div class="card mt-4 shadow-sm">
        <div class="card-header bg-primary text-white">
            <h5 class="m-0"><i class="fas fa-pen"></i> Cevap Yaz</h5>
        </div>
        <div class="card-body">
            @if (User.Identity.IsAuthenticated)
            {
                <form asp-controller="Answer" asp-action="Create" method="post">
                    <input type="hidden" name="QuestionId" value="@Model.Id" />
                    <div class="form-group">
                        <textarea name="contents" class="form-control" rows="4" placeholder="Cevabınızı buraya yazın..." required></textarea>
                    </div>
                    <button type="submit" class="btn btn-success mt-3 px-4">
                        <i class="fas fa-paper-plane"></i> Gönder
                    </button>
                </form>
            }
            else
            {
                <div class="text-center">
                    <p class="lead">Cevap yazmak için giriş yapmalısınız.</p>
                    <a asp-controller="Auth" asp-action="Login" class="btn btn-primary">Giriş Yap</a>
                </div>
            }
        </div>
    </div>
</div>