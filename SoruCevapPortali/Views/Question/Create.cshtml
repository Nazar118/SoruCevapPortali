@model SoruCevapPortali.Models.Question

@{
    ViewData["Title"] = "Yeni Soru Sor";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow mt-4 border-left-primary">
            <div class="card-header bg-white border-bottom-0 pt-4 pb-0">
                <h3 class="text-primary font-weight-bold"><i class="fas fa-plus-circle"></i> Yeni Soru Sor</h3>
                <p class="text-muted">Topluluğumuzdan yardım almak için sorunu detaylandır.</p>
            </div>
            <div class="card-body">
                <form asp-action="Create">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <div class="form-group mb-3">
                        <label asp-for="title" class="control-label font-weight-bold">Soru Başlığı</label>
                        <input asp-for="title" class="form-control form-control-lg" placeholder="Örn: Cilt bakımında C vitamini serumu nasıl kullanılır?" />
                        <span asp-validation-for="title" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="CategoryId" class="control-label font-weight-bold">Kategori</label>
                        <select asp-for="CategoryId" class="form-control" asp-items="ViewBag.CategoryId">
                            <option value="">-- Bir Kategori Seçin --</option>
                        </select>
                        <span asp-validation-for="CategoryId" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-4">
                        <label asp-for="contents" class="control-label font-weight-bold">Detaylı Açıklama</label>
                        <textarea asp-for="contents" class="form-control" rows="6" placeholder="Sorunuzu olabildiğince detaylı açıklayın..."></textarea>
                        <span asp-validation-for="contents" class="text-danger"></span>
                    </div>

                    <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                        <a asp-controller="Home" asp-action="Index" class="btn btn-light mr-2">İptal</a>
                        <button type="submit" class="btn btn-primary px-5">
                            <i class="fas fa-paper-plane"></i> Soruyu Gönder
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}