@{
    ViewData["Title"] = "Giriş Yap";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-4">
        <div class="card shadow" style="background-color: var(--bg-card); border: 1px solid var(--border-color);">
            <div class="card-body p-4">
                <h3 class="text-center mb-4" style="color: var(--main-pink);">Giriş Yap</h3>

                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger">@ViewBag.Error</div>
                }

                <form asp-action="Login" method="post">
                    <div class="mb-3">
                        <label class="form-label text-light">E-Posta</label>
                        <input type="email" name="email" class="form-control" required style="background-color: var(--bg-input); color: white; border-color: #444;" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label text-light">Şifre</label>
                        <input type="password" name="password" class="form-control" required style="background-color: var(--bg-input); color: white; border-color: #444;" />
                    </div>
                    <button type="submit" class="btn btn-primary w-100">Giriş Yap</button>
                </form>
                <div class="mt-3 text-center">
                    <a asp-action="Register" class="text-muted">Hesabın yok mu? Kayıt Ol</a>
                </div>
            </div>
        </div>
    </div>
</div>