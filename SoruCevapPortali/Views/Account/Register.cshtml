@model SoruCevapPortali.Models.User
@{
    ViewData["Title"] = "Kayıt Ol";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-5">
        <div class="card shadow" style="background-color: var(--bg-card); border: 1px solid var(--border-color);">
            <div class="card-body p-4">
                <h3 class="text-center mb-4" style="color: var(--main-pink);">Aramıza Katıl</h3>

                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger">@ViewBag.Error</div>
                }

                <form asp-action="Register" method="post">

                    <div class="mb-3">
                        <label class="form-label text-light">Kullanıcı Adı</label>
                        <input asp-for="User_name" class="form-control" required style="background-color: var(--bg-input); color: white; border-color: #444;" />
                        <span asp-validation-for="User_name" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label text-light">E-Posta</label>
                        <input asp-for="Email" type="email" class="form-control" required style="background-color: var(--bg-input); color: white; border-color: #444;" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label text-light">Şifre</label>
                        <input asp-for="Password" type="password" class="form-control" required style="background-color: var(--bg-input); color: white; border-color: #444;" />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-primary w-100">Kayıt Ol</button>
                </form>

                <div class="mt-3 text-center">
                    <a asp-action="Login" class="text-muted">Zaten hesabın var mı? Giriş Yap</a>
                </div>
            </div>
        </div>
    </div>
</div>