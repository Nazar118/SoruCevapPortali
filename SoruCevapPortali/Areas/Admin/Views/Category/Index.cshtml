@model IEnumerable<SoruCevapPortali.Models.Category>
@{
    ViewData["Title"] = "Kategori Yönetimi";
}

<h1>Kategori Yönetimi</h1>
@Html.AntiForgeryToken()

<p>
    <a asp-action="Create" class="btn btn-primary">Yeni Kategori Ekle</a>
</p>

<div class="card shadow mb-4">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-bordered" id="dataTable" width="100%" cellspacing="0">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Kategori Adı</th>
                        <th>Düzenle</th>
                        <th>Sil</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var kategori in Model)
                    {
                        <tr>
                            <td>@kategori.Id</td>
                            <td>@kategori.Name</td>
                            <td>
                                <a asp-action="Edit" asp-route-id="@kategori.Id" class="btn btn-success btn-sm">Düzenle</a>
                            </td>
                            <td>
                                <form asp-action="Delete" asp-route-id="@kategori.Id" method="post" onsubmit="return confirm('Bu kategoriyi silmek istediğinizden emin misiniz?');">
                                    <button type="submit" class="btn btn-danger btn-sm">Sil</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>