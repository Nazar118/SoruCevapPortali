@model IEnumerable<SoruCevapPortali.Models.Answer>

@{
    ViewData["Title"] = "Cevap Listesi";
}

<h1>Cevap Yönetimi</h1>
@Html.AntiForgeryToken()

<div class="card shadow mb-4">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-bordered" id="dataTable" width="100%" cellspacing="0">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Cevap İçeriği</th>
                        <th>Cevaplayan</th>
                        <th>Ait Olduğu Soru</th>
                        <th>Tarih</th>
                        <th>En İyi Cevap?</th>
                        <th>İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var answer in Model)
                    {
                        <tr>
                            <td>@answer.Id</td>
                            <td>@answer.contents</td>
                            <td>@(answer.User?.User_name ?? "Bilinmiyor")</td>
                            <td>@(answer.Question?.title ?? "Bilinmiyor")</td>
                            <td>@answer.creation_date.ToShortDateString()</td>

                            <td>
                                <button class="btn btn-sm toggle-best-btn @(answer.IsBestAnswer ? "btn-success" : "btn-secondary")" data-id="@answer.Id">
                                    @(answer.IsBestAnswer ? "Evet (En İyi)" : "İşaretle")
                                </button>
                            </td>

                            <td>
                                <form asp-action="Delete" asp-route-id="@answer.Id" method="post" onsubmit="return confirm('Bu cevabı silmek istediğinizden emin misiniz?');">
                                    <button type="submit" class="btn btn-danger btn-sm">Sil</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('.toggle-best-btn').click(function () {
                var clickedButton = $(this);
                var answerId = clickedButton.data('id');

                $.ajax({
                    // DOĞRU ADRES: /Admin/Answer/ToggleBestAnswer
                    url: '/Admin/Answer/ToggleBestAnswer',
                    type: 'POST',
                    data: { id: answerId },
                    headers: {
                        "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
                    },
                    success: function (response) {
                        if (response.success) {
                            // Controller'dan gelen liste ile butonları güncelle
                            response.updatedAnswers.forEach(function(item) {

                                var btn = $('.toggle-best-btn[data-id="' + item.id + '"]');

                                if (item.isBest) {
                                    btn.removeClass('btn-secondary').addClass('btn-success').text('Evet (En İyi)');
                                } else {
                                    btn.removeClass('btn-success').addClass('btn-secondary').text('İşaretle');
                                }
                            });
                        } else {
                            alert("Bir hata oluştu!");
                        }
                    },
                    error: function () {
                        alert("Sunucuyla iletişim kurulamadı!");
                    }
                });
            });
        });
    </script>
}