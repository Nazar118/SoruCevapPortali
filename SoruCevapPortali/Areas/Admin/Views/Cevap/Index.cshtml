@model IEnumerable<SoruCevapPortali.Models.Cevap>

@{
    ViewData["Title"] = "Cevap Listesi";
}

<h1>Cevap Yönetimi</h1>

<div class="card shadow mb-4">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-bordered" id="dataTable" width="100%" cellspacing="0">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Cevap İçeriği</th>
                        <th>Cevaplayan</th>
                        <th>Ait Olduğu Soru</th>
                        <th>Tarih</th>
                        <th>İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var cevap in Model)
                    {
                        <tr>
                            <td>@cevap.Id</td>
                            <td>@cevap.Icerik</td>
                            <td>@(cevap.CevaplayanKullanici?.KullaniciAdi ?? "Bilinmiyor")</td>
                            <td>@(cevap.AitOlduguSoru?.Baslik ?? "Bilinmiyor")</td>
                            <td>@cevap.OlusturmaTarihi.ToShortDateString()</td>
                            <td>
                                <form asp-action="Delete" asp-route-id="@cevap.Id" method="post" onsubmit="return confirm('Bu cevabı silmek istediğinizden emin misiniz?');">
                                    <button type="submit" class="btn btn-danger btn-sm">Sil</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>