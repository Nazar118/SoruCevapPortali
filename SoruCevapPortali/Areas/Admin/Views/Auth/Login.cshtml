@model SoruCevapPortali.Areas.Admin.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Giriş Yap";
    Layout = "~/Views/Shared/_Layout.cshtml"; // Pembe menülü ana şablonu kullan
}

<div class="row justify-content-center mt-5">
    <div class="col-md-5">
        <div class="card shadow-lg border-0 rounded-lg">
            <div class="card-header bg-primary text-white text-center py-4">
                <h3 class="font-weight-light my-1"><i class="fas fa-user-check"></i> Giriş Yap</h3>
            </div>

            <div class="card-body p-5">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <form asp-action="Login" method="post">
                    <div class="form-group mb-3">
                        <label asp-for="Email" class="text-muted mb-1">E-Posta Adresi</label>
                        <input asp-for="Email" class="form-control form-control-lg" placeholder="name@example.com" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-4">
                        <label asp-for="Sifre" class="text-muted mb-1">Şifre</label>
                        <input asp-for="Sifre" type="password" class="form-control form-control-lg" placeholder="Şifreniz" />
                        <span asp-validation-for="Sifre" class="text-danger"></span>
                    </div>

                    <div class="d-grid mt-4">
                        <button type="submit" class="btn btn-primary btn-block btn-lg">
                            Giriş Yap
                        </button>
                    </div>
                </form>
            </div>

            <div class="card-footer text-center py-3 bg-white border-top-0">
                <div class="small">
                    <a asp-area="Admin" asp-controller="Auth" asp-action="Register" class="text-primary font-weight-bold">
                        Hesabın yok mu? Kayıt Ol!
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>