@model SoruCevapPortali.Models.Soru

@{
    ViewData["Title"] = "Soruyu Düzenle";
}

<h1>Soruyu Düzenle</h1>
<hr />
<div class="row">
    <div class="col-md-8">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />

            <input type="hidden" asp-for="KullaniciId" />
            <input type="hidden" asp-for="OlusturmaTarihi" />

            <div class="form-group">
                <label asp-for="KategoriId" class="control-label">Kategori</label>
                <select asp-for="KategoriId" class="form-control" asp-items="ViewBag.Kategoriler">
                    <option value="">-- Kategori Seçiniz --</option>
                </select>
                <span asp-validation-for="KategoriId" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Baslik" class="control-label"></label>
                <input asp-for="Baslik" class="form-control" />
                <span asp-validation-for="Baslik" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Icerik" class="control-label"></label>
                <textarea asp-for="Icerik" class="form-control" rows="5"></textarea>
                <span asp-validation-for="Icerik" class="text-danger"></span>
            </div>

            <div class="form-group">
                <input type="submit" value="Kaydet" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary">Listeye Geri Dön</a>
            </div>
        </form>
    </div>
</div>